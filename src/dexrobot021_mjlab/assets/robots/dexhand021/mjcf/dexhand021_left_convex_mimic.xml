  <!-- <dcmotor input="position"> actuators.  nominal = (voltage, stall
       torque, no-load speed); the no-load speeds were measured on the hardware
       one joint at a time with an empty hand (p90 over the joint's travel):

         group                no-load speed (rad/s)
         *_2 MCP flexion          5.15
         *_3 PIP (DIP linked)     5.13
         1_1 thumb rotation       6.93
         2_1 abduction            1.17

       The hardware is asymmetric (flexion faster than extension), which a
       <dcmotor> envelope cannot express.  Stall torques are derived from the
       published cable tension, not measured; thumb rotation and abduction are
       estimates. -->
  <actuator>
    <!-- finger 1 MCP flexion, cable: 10 N at 94 mm -->
    <dcmotor name="act_l_f_joint1_2" joint="l_f_joint1_2" input="position"
             nominal="24 0.9 7.06" saturation="0.9 0 0"
             controller="80 0 2.66667 0 0 24" ctrlrange="0 1.3" />
