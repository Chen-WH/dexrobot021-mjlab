<?xml version='1.0' encoding='utf-8'?>
<mujoco model="dexhand021_left_convex_mimic">
  <visual>
    <global offwidth="1920" offheight="1080" />
  </visual>
  <option gravity="0 0 -9.81" iterations="100" solver="Newton" integrator="implicit" timestep="0.001" />
  <default>
    <!-- Drive parameters follow Yuan et al., "Development of the Bioinspired
         Tendon-Driven DexHand 021 With Proprioceptive Compliance Control",
         IEEE RA-L 11(1), 2026.  Motor -> planetary reducer -> worm gear ->
         capstan -> cable, so the joints are stiff and poorly backdrivable.
         The classes below name the three drive groups. -->
    <joint damping="0.05" armature="0.002" frictionloss="0" />
    <!-- Cable-driven flexion: the MCP (*_2) and PIP (*_3) of all five
         fingers, ten of the twelve motors. -->
    <!-- frictionloss: the worm gear is self-locking.  No number is published;
         this is ~11-17 % of the group's stall torque and is randomised in
         training. -->
    <default class="tendon_flexion">
      <joint damping="0.035" armature="0.002" frictionloss="0.07" />
    </default>
    <!-- Geared direct drive: thumb rotation (motor + worm) and four-finger
         abduction (motor + ball screw + crank linkage).  Two motors. -->
    <default class="direct_drive">
      <joint damping="0.035" armature="0.002" frictionloss="0.042" />
    </default>
    <!-- No motor: driven through a rigid linkage by <equality>.  The DIP (*_4)
         follows the PIP (*_3); ring/little abduction follows the index.
         DIP = g(PIP) is a polynomial fit to the vendor's joint mapping table
         (rms 0.004 deg over PIP <= 1.39 rad).  PIP range 0-1.3 rad is the
         firmware limit. -->
    <!-- No transmission upstream, so only pin-and-linkage friction. -->
    <default class="passive_linkage">
      <joint damping="0.035" armature="2e-4" frictionloss="0.014" />
    </default>
    <!-- friction = "tangential torsional rolling".

         tangential 1.0: typical for a rubber pad on a plastic object, and the
         nominal the training randomiser scales around.

         torsional 0.003 with condim="4" so that it is active: without torsional
         friction a contact offers no resistance to rotation about its own
         normal, which lets two fingertips spin an object unrealistically fast.
         MuJoCo's torsional coefficient is a length (~ (2/3) mu a for a contact
         patch of radius a); 0.003 is a ~4.5 mm patch, a lightly loaded
         fingertip.  Randomised in training.

         rolling 0.002 is inert at condim="4" (it needs 6).

         priority 1: when two geoms' priorities differ, MuJoCo uses the higher
         one's friction/condim/solref/solimp outright instead of mixing them.
         The objects ship with priority 0, so this side governs every
         hand-object contact and contact randomisation on the hand reaches the
         contact unchanged. -->
    <geom condim="4" solref="0.02 1" solimp="0.9 0.95 0.001" friction="1.0 0.003 0.002"
          priority="1" />
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" density="0" />
    </default>
    <default class="collision">
      <geom contype="0" conaffinity="1" group="1" density="0" />
    </default>
  </default>
  <size njmax="1000" nconmax="1000" />
  <compiler angle="radian" meshdir="../meshes/" />
